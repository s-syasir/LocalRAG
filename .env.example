# Path to Joplin's SQLite database
# Default location on Linux:   ~/.config/joplin-desktop/database.sqlite
# Default location on macOS:   ~/Library/Application Support/joplin-desktop/database.sqlite
# Default location on Windows: %APPDATA%\joplin-desktop\database.sqlite
JOPLIN_DB_PATH=~/.config/joplin-desktop/database.sqlite

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Embedding model (downloads automatically on first run)
EMBED_MODEL=all-MiniLM-L6-v2

# Where to store the vector database
CHROMA_PATH=./chroma_db

# Chunking settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# How many note chunks to retrieve per query
TOP_K=5
